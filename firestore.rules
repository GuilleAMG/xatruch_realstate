rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isParticipant(participants) {
      return isAuthenticated() && (participants != null && request.auth.uid in participants);
    }

    // Users collection
    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      // Favorites subcollection — only the owner can read/write
      match /favoritos/{propertyId} {
        allow read, write: if isOwner(userId);
      }

      // Following subcollection — only the owner can read/write
      match /siguiendo/{targetUserId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Reports collection — any authenticated user can create
    match /reportes/{reportId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && request.auth.uid == resource.data.reporterId;
    }

    // Properties collection
    match /propiedades/{propertyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.sellerId;
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.sellerId;
    }

    // Chats collection
    match /chats/{chatId} {
      // Allow get even if doc doesn't exist (to support Existence checks in 'getOrCreateChatRoom')
      allow get: if isAuthenticated() && (resource == null || isParticipant(resource.data.participants));
      // Only show chats where the user is a participant
      allow list: if isAuthenticated() && isParticipant(resource.data.participants);
      // Allow creation if the current user is one of the participants
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      // Only participants can update or delete
      allow update, delete: if isParticipant(resource.data.participants);
    }

    // Messages subcollection under chats
    match /chats/{chatId}/messages/{messageId} {
      // Allow read/write if user is a participant in the parent chat
      // We use get() here to check the parent document's participants
      allow read, write: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
    }

    // Notifications collection
    match /notificaciones/{notificationId} {
      allow read, write: if isOwner(resource.data.userId);
    }
  }
}