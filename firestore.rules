rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function getUserDataOrDefault() {
      let userDoc = get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
      return userDoc.exists ? userDoc.data : {};
    }

    function isAdmin() {
      return isAuth() && getUserDataOrDefault().get('isAdmin', false) == true;
    }

    function isChatParticipant(chatData) {
      return isAuth() && request.auth.uid in chatData.participants;
    }


    // ─────────────────────────────────────────────
    // USUARIOS
    // ─────────────────────────────────────────────
    match /usuarios/{userId} {

      allow read: if isAuth();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['nombre', 'email', 'createdAt'])
        && request.resource.data.isAdmin == false
        && request.resource.data.isPremium == false
        || (isOwner(userId)
          && request.resource.data.keys().size() <= 2
          && 'fcmToken' in request.resource.data);

      // ✅ Temporarily relaxed: any authenticated user can update their own
      // profile including tier, isPremium, premiumSince (subscription fields).
      allow update: if isOwner(userId) || isAdmin();

      allow delete: if isAdmin();


      match /favoritos/{favoritoId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /siguiendo/{siguiendoId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /notificaciones/{notifId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAuth();
        allow update, delete: if isOwner(userId) || isAdmin();
      }
    }


    // ─────────────────────────────────────────────
    // PROPIEDADES (Listings)
    // ─────────────────────────────────────────────
    match /propiedades/{propiedadId} {

      // ✅ Any authenticated user can read listings.
      allow read: if isAuth();

      // ✅ Temporarily relaxed: any authenticated user can create a listing,
      // regardless of tier, isPremium, or premiumSince.
      // TODO: restore subscription check once billing is stable.
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;

      // ✅ Any authenticated user can update or delete their own listing.
      allow update, delete: if (isAuth()
        && resource.data.ownerId == request.auth.uid)
        || isAdmin();
    }


    // ─────────────────────────────────────────────
    // CHATS
    // ─────────────────────────────────────────────
    match /chats/{chatId} {

      allow read: if isChatParticipant(resource.data) || isAdmin();

      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      allow update: if isChatParticipant(resource.data) || isAdmin();

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isChatParticipant(
          get(/databases/$(database)/documents/chats/$(chatId)).data
        ) || isAdmin();

        allow create: if isChatParticipant(
          get(/databases/$(database)/documents/chats/$(chatId)).data
        ) && request.resource.data.senderId == request.auth.uid;

        allow update: if false;
        allow delete: if isAdmin();
      }
    }


    // ─────────────────────────────────────────────
    // REPORTES
    // ─────────────────────────────────────────────
    match /reportes/{reporteId} {

      allow create: if isAuth()
        && request.resource.data.reporterId == request.auth.uid;

      allow read: if isAdmin()
        || (isAuth() && resource.data.reporterId == request.auth.uid);

      allow update, delete: if isAdmin();
    }


    // ─────────────────────────────────────────────
    // SOPORTE
    // ─────────────────────────────────────────────
    match /soporte/{ticketId} {

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll([
            'userId', 'content', 'status', 'createdAt', 'channel'
           ])
        && request.resource.data.status == 'open';

      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);

      allow update, delete: if isAdmin();
    }

  }
}
